{
  "name": "supportflow-ai",
  "private": true,
  "version": "0.1.0",
  "description": "SupportFlow AI — multi-tenant AI customer support automation SaaS (Phase 1 only)",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "npm --workspace apps/api run dev",
    "build": "npm --workspace packages/shared run build && npm --workspace apps/api run build && npm --workspace apps/web run build",
    "build:shared": "npm --workspace packages/shared run build",
    "build:api": "npm --workspace apps/api run build",
    "build:web": "npm --workspace apps/web run build",
    "lint": "eslint apps packages --ext .ts,.tsx",
    "test": "npm --workspace apps/api run test -- --run && npm --workspace apps/web run test -- --run",
    "test:api": "npm --workspace apps/api run test -- --run",
    "test:web": "npm --workspace apps/web run test -- --run"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "concurrently": "^9.0.1",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.46.0"
  }
}
