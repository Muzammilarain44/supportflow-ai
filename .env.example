# SupportFlow AI — Phase 1 environment variables
# Copy to .env (root) / apps/web/.env / apps/api/.env as needed. NEVER commit real keys.
# Supabase project: "SupportFlow AI"
# Supabase URL (public project URL supplied by the user — not a secret)
SUPABASE_URL=https://ylqfcfrqbxeevemkkbha.supabase.co
# Get these from Supabase Dashboard > Project Settings > API (ask the project owner for them)
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Frontend (Vite) — same values, VITE_ prefix, in apps/web/.env
VITE_SUPABASE_URL=https://ylqfcfrqbxeevemkkbha.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_API_URL=http://localhost:4000
# Backend
PORT=4000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# ---- Phase 3: AI providers (Groq first, Gemini fallback) ----
# Keys come from the owner via Secure Vault and are set in Render env only.
# Never commit real keys, never paste them in chat. Verify the model names
# live in the Groq console / Google AI Studio before production use.
# Order in which providers are tried (comma-separated).
AI_PROVIDER_ORDER=groq,gemini
GROQ_API_KEY=your-groq-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
# Default models (verified 2026-11-15: Groq chat completion works with
# openai/gpt-oss-20b; NO Llama chat models on the free roster — never use
# llama-3.3-70b / llama-3.1-8b. Gemini generation NOT yet proven live —
# one call returned HTTP 503; fallback chain below is tried per model.)
AI_MODEL_GROQ=openai/gpt-oss-20b
AI_MODEL_GROQ_QUALITY=openai/gpt-oss-120b
AI_MODEL_GEMINI=gemini-3.8-flash
AI_MODEL_GEMINI_FALLBACKS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Per-request timeout for AI provider calls, in milliseconds.
AI_REQUEST_TIMEOUT_MS=20000

# ---- Phase 3: automation webhook (dispatcher <-> n8n <-> API) ----
# Public webhook URL of the n8n workflow on the owner's laptop, via the free
# Cloudflare Tunnel, e.g. https://<tunnel>/webhook/supportflow-message.
N8N_WEBHOOK_URL=https://your-tunnel-url/webhook/supportflow-message
# Shared HMAC secret — SAME value in Render (AUTOMATION_WEBHOOK_SECRET) and
# in n8n (N8N_WEBHOOK_SECRET). NOT the n8n encryption key. Generate with:
# openssl rand -hex 32 (or the PowerShell equivalent in docs/phase3-n8n-setup.md).
AUTOMATION_WEBHOOK_SECRET=your-automation-webhook-secret-here
# When true, the dispatcher calls the AI step in-process and skips n8n.
AI_DIRECT_PROCESSING=false
# Base URL of the API, used by the n8n workflow (its $env.API_BASE_URL).
API_BASE_URL=https://supportflow-api-q0md.onrender.com

# ---- Phase 3: dispatcher / worker ----
# How often the worker polls the automation_events outbox, in milliseconds.
WORKER_POLL_MS=5000
# How many pending events the worker claims per poll.
WORKER_BATCH_SIZE=10
